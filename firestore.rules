rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Utilidades
    // ---------------------------------------------------------------------

    // Solo el usuario autenticado puede tocar su propio subarbol.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Error si el cliente intenta escribir un campo fuera del esquema.
    // (hasOnly actua como lista blanca de claves.)

    // ---------------------------------------------------------------------
    // Perfil: users/{uid}
    // El esquema del perfil aun no esta definido; solo se acota el numero de
    // campos y el tipo de las marcas de tiempo habituales.
    // ---------------------------------------------------------------------
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.size() <= 15
        && (!request.resource.data.keys().hasAny(['createdAt'])
            || request.resource.data.createdAt is timestamp)
        && (!request.resource.data.keys().hasAny(['updatedAt'])
            || (request.resource.data.updatedAt is timestamp
                && request.resource.data.updatedAt == request.time));

      allow update: if isOwner(uid)
        && request.resource.data.size() <= 15
        && (!request.resource.data.keys().hasAny(['createdAt'])
            || (request.resource.data.createdAt is timestamp
                && request.resource.data.createdAt == resource.data.createdAt))
        && (!request.resource.data.keys().hasAny(['updatedAt'])
            || (request.resource.data.updatedAt is timestamp
                && request.resource.data.updatedAt == request.time));

      // Borrado duro permitido para limpieza; la app usa borrado suave.
      allow delete: if isOwner(uid);

      // -------------------------------------------------------------------
      // Cursos: users/{uid}/courses/{courseId}
      // -------------------------------------------------------------------
      match /courses/{courseId} {
        allow read, write: if isOwner(uid);
      }

      // -------------------------------------------------------------------
      // Tareas: users/{uid}/tasks/{taskId}
      // -------------------------------------------------------------------
      match /tasks/{taskId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
