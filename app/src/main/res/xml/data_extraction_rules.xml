<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de extracción de datos (API 31+).
   El backup y la transferencia entre dispositivos incluyen solo los datos
   reales de la app: Room (`notally.db` + WAL/SHM) y el DataStore de ajustes.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="notally.db" />
        <include domain="database" path="notally.db-wal" />
        <include domain="database" path="notally.db-shm" />
        <include domain="file" path="datastore/notally_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="notally.db" />
        <include domain="database" path="notally.db-wal" />
        <include domain="database" path="notally.db-shm" />
        <include domain="file" path="datastore/notally_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
